# ── MongoDB ──────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=shiptrack

# ── Kafka ────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_GPS=gps_stream
KAFKA_CONSUMER_GROUP=shiptrack-consumer

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_GPS_TTL=10               # giây — expire GPS cache sau 10s

# ── Backend ──────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Simulator ────────────────────────────────
BACKEND_WS_URL=ws://localhost:8000/ws/ingest
SIMULATOR_SHIPPER_COUNT=100
SIMULATOR_GPS_INTERVAL=1.0     # giây giữa mỗi GPS update

# ── Business Rules ───────────────────────────
GPS_TIMEOUT_SECONDS=30         # cảnh báo OFFLINE nếu không nhận GPS sau 30s
MAX_SPEED_KMPH=80              # tốc độ bất hợp lệ (> 80 km/h → reject)
MAX_RETRY_ASSIGN=5             # số lần thử gán shipper tối đa
IDLE_WARNING_SECONDS=120       # cảnh báo đứng yên quá 2 phút
DELAY_ALERT_MINUTES=15         # cảnh báo trễ nếu > 15 phút

# ── Frontend ─────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
